# Normalise line endings so diffs stay clean across Windows and Linux runners.
# Without this, every git operation on Windows emits an LF/CRLF warning and
# shell scripts checked out on Windows end up with CRLF, which breaks bash.

* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.tf    text eol=lf
*.tfvars text eol=lf
*.hcl   text eol=lf
*.xml   text eol=lf
*.conf  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf
*.gradle text eol=lf
*.kts   text eol=lf
*.kt    text eol=lf
*.java  text eol=lf
Dockerfile     text eol=lf
*.service      text eol=lf
*.j2           text eol=lf

# Never touch line endings in these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.jar   binary
*.apk   binary
*.aab   binary
*.exe   binary
*.dll   binary
*.so    binary
*.keystore binary
